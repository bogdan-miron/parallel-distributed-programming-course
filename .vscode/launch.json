{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: debug active lab",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/build/main",
      "args": ["${input:threads}", "${input:variant}"],
      "cwd": "${input:dataDir}",
      "MIMode": "gdb",
      "preLaunchTask": "lab: build",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Java: debug active lab",
      "type": "java",
      "request": "launch",
      "mainClass": "Main",
      "classPaths": ["${fileDirname}/build"],
      "args": "${input:threads} ${input:variant}",
      "cwd": "${input:dataDir}",
      "preLaunchTask": "lab: build"
    }
  ],
  "inputs": [
    { "id": "threads", "type": "promptString", "description": "threads (0 = sequential)", "default": "0" },
    { "id": "variant", "type": "promptString", "description": "variant (leave empty if the lab has none)", "default": "" },
    { "id": "dataDir", "type": "promptString", "description": "folder with the input files", "default": "${env:HOME}/ppd_data" }
  ]
}
